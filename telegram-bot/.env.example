# Telegram API credentials - get these from https://my.telegram.org/apps
API_ID=123456
API_HASH=your_api_hash_here

# Bot token from @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase credentials - find these in: Project Settings → API
# URL: the project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
# SERVICE_KEY: the "service_role" secret key (bypasses Row Level Security)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
